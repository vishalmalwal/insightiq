# Copy to .env and fill in. NEVER commit .env.

# ---- LLM ----
LLM_PROVIDER=mock                 # mock (tests/CI, $0) | gemini (free tier) | anthropic (paid alt)
GOOGLE_API_KEY=                   # Gemini free-tier key from Google AI Studio
# ANTHROPIC_API_KEY=              # only if LLM_PROVIDER=anthropic (bring-your-own paid key)

# ---- Access boundary ----
# Optional shared secret gating write/LLM actions. Leave blank for the open
# public sample-data demo. Clients send it via the `x-app-secret` header.
APP_SHARED_SECRET=

# ---- App metadata DB (Postgres; Neon free tier in deploy) ----
DATABASE_URL=postgresql+psycopg://insightiq:insightiq@localhost:5432/insightiq
# Deploy example (Neon): postgresql+psycopg://USER:PASS@ep-xxx.neon.tech/insightiq?sslmode=require

# ---- Analytics storage (DuckDB) ----
STORAGE_BACKEND=local             # local (dev) | r2 (deploy)
DUCKDB_DIR=./data/duckdb          # local working/cache dir
# Cloudflare R2 (only when STORAGE_BACKEND=r2):
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---- Security ----
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# ---- CORS (deploy) ----
# JSON list of allowed browser origins. Dev default already allows localhost:5173.
# CORS_ORIGINS=["https://insightiq.vercel.app"]

# ---- Misc ----
ENVIRONMENT=local
LOG_LEVEL=INFO
